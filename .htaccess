# ============================================================
# Recovery Interface — Apache access rules & security headers
# Rules are RELATIVE to this file's folder, so they work both at
# web root and inside a subfolder like localhost/fit-app/.
#
# Every match below is CASE-INSENSITIVE ([NC], (?i)) on purpose: on Windows
# (XAMPP) file names are case-insensitive, so "/CONFIG/database.php" opens the
# same file as "/config/database.php". A case-sensitive rule would block the
# second and let the first straight through.
# ============================================================

# 1. No directory listings
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 2. Block anything starting with a dot, FILES AND FOLDERS (.git/, .env, .vscode/).
    #    <FilesMatch> alone can't do this: for /.git/HEAD it only sees "HEAD".
    RewriteRule (^|/)\. - [F,L]

    # 3. ALLOW-LIST: only the public parts of the app can be requested at all —
    #    the page (index.html or the folder itself), css/, js/ and the API endpoints.
    #    Everything else is 403: bll/, dal/, config/, tests/, vendor/, backups/, docs/,
    #    README.md… and any folder added in the future, without having to list it here.
    RewriteRule !^(index\.html|css/.+|js/.+|pages/api_[a-z_]+\.php)?$ - [F,NC,L]

    # 4. Second layer: the internal folders by name (in case rule 3 is ever loosened)
    RewriteRule ^(bll|dal|config|database|tests|docs|vendor|backups)(/|$) - [F,NC,L]
</IfModule>

# 5. Defence in depth: block these file types even if they end up somewhere public
#    (also covers servers without mod_rewrite, where rules 2–4 don't run)
<FilesMatch "(?i)\.(sql|gz|zip|tar|7z|rar|log|md|example|ini|sh|bak|dist|neon|cache|env)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(composer\.(json|lock)|phpunit\.xml|package(-lock)?\.json|LICENSE)$">
    Require all denied
</FilesMatch>

# 6. Security headers for the page itself (index.html, css, js)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content-Security-Policy: the browser refuses to run/load anything not listed here.
    # Even if an attacker injected <script> into the page, it wouldn't execute.
    #   script-src 'self'            → only our own js/ files; no inline scripts, no eval
    #   style-src 'unsafe-inline'    → temporary: index.html still uses style="" attributes
    #   font-src 'self'              → the Archivo font is self-hosted (css/fonts/)
    #   img-src data:                → the SVG icons embedded in CSS
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" "expr=%{CONTENT_TYPE} =~ m#text/html#"
</IfModule>