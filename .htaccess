# ============================================================
# Recovery Interface — Apache access rules & security headers
# Rules are RELATIVE to this file's folder, so they work both at
# web root and inside a subfolder like localhost/fit-app/.
# ============================================================

# 1. No directory listings
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 2. Block anything starting with a dot, FILES AND FOLDERS (.git/, .env, .vscode/).
    #    <FilesMatch> alone can't do this: for /.git/HEAD it only sees "HEAD".
    RewriteRule (^|/)\. - [F,L]

    # 3. Block internal folders — only index.html, css/, js/ and pages/ are public
    RewriteRule ^(bll|dal|config|database|tests|docs|vendor|backups)(/|$) - [F,L]
</IfModule>

# 4. Defence in depth: block these file types even if they end up somewhere public
<FilesMatch "\.(sql|gz|zip|tar|7z|rar|log|md|example|ini|sh|bak|dist|neon|cache)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|phpunit\.xml|package(-lock)?\.json|LICENSE)$">
    Require all denied
</FilesMatch>

# 5. Security headers for the page itself (index.html, css, js)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content-Security-Policy: the browser refuses to run/load anything not listed here.
    # Even if an attacker injected <script> into the page, it wouldn't execute.
    #   script-src 'self'            → only our own js/ files; no inline scripts, no eval
    #   style-src 'unsafe-inline'    → temporary: index.html still uses style="" attributes
    #   font-src 'self'              → the Archivo font is self-hosted (css/fonts/)
    #   img-src data:                → the SVG icons embedded in CSS
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" "expr=%{CONTENT_TYPE} =~ m#text/html#"
</IfModule>