{
    "name": "rafael-monteiro/recovery-interface",
    "description": "Muscle readiness and workout fatigue tracker (PHP, MySQL, vanilla JS)",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "classmap": ["bll/", "dal/", "config/database.php"]
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:smoke": "php tests/ApiSmokeTest.php",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
