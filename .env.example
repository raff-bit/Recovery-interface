# ============================================================
# RECOVERY INTERFACE — Environment Configuration Template
# Copy this file to '.env' and fill in your settings.
# .env is git-ignored and blocked from the web by .htaccess: never commit it.
# ============================================================

# Database connection
# XAMPP's default is root with no password — fine on your own machine only.
# Anywhere else, create a dedicated user with a strong password that only has
# access to this database.
DB_HOST=localhost
DB_NAME=muscle_recovery_v2
DB_USER=root
DB_PASS=
DB_PORT=3306

# Safe by default. On YOUR machine you may set APP_ENV=development and
# APP_DEBUG=true to see error details in API responses — never on a server.
APP_ENV=production
APP_DEBUG=false

# Optional: where database/backup.php writes dumps. Dumps contain every
# account's data, so a folder OUTSIDE the web root is safest, e.g.:
# BACKUP_DIR=C:/xampp/backups/recovery
